{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opennv.dev/schemas/clisynth/outputfsm-v1alpha1.json",
  "title": "CliSynth OutputFSM",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "clisynth.opennv.io/v1alpha1"},
    "kind": {"const": "OutputFSM"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$"},
        "version": {"type": "string"},
        "description": {"type": "string"},
        "labels": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "command", "template"],
      "properties": {
        "platform": {"type": "string", "minLength": 1},
        "platformAliases": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "command": {"type": "string", "minLength": 1},
        "commandAliases": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "template": {"type": "string", "minLength": 1},
        "variables": {
          "type": "object",
          "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
          "additionalProperties": {"$ref": "#/$defs/variable"}
        },
        "conditions": {
          "type": "array",
          "items": {"$ref": "#/$defs/condition"}
        },
        "starlark": {"type": "string"}
      }
    }
  },
  "$defs": {
    "variable": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {"required": ["source"]},
        {"required": ["generator"]},
        {"required": ["default"]}
      ],
      "not": {"required": ["source", "generator"]},
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "default": true,
        "required": {"type": "boolean"},
        "transform": {"enum": ["string", "lower", "upper", "trim", "json"]},
        "generator": {"$ref": "#/$defs/generator"}
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["integer", "choice", "hex", "mac", "ipv4", "identity", "uptime_human", "yes_no", "up_down", "percent", "join", "on_off"]},
        "source": {"type": "string", "minLength": 1},
        "min": {"type": "integer"},
        "max": {"type": "integer"},
        "length": {"type": "integer", "minimum": 1, "maximum": 128},
        "prefix": {"type": "string"},
        "values": {"type": "array", "minItems": 1},
        "precision": {"type": "integer", "minimum": 0, "maximum": 6},
        "separator": {"type": "string", "maxLength": 32}
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["when"],
      "anyOf": [{"required": ["set"]}, {"required": ["else"]}],
      "properties": {
        "when": {"type": "string", "minLength": 1},
        "set": {"type": "object"},
        "else": {"type": "object"}
      }
    }
  }
}
